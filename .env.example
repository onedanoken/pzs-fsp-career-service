# Login accepts username or email; new registrations require verified email.
# start.ps1 reads FSP_* settings from .env. Defaults are shown.
FSP_DEMO=0
FSP_ENABLE_ML=0
FSP_TORCH_THREADS=2
FSP_SECURE_COOKIE=0
# Configure origins when exposing the app at a different address.
# FSP_ALLOWED_ORIGINS=https://demo.example.org
# PostgreSQL is required for every app/test start; no SQLite fallback.
# Choose a long random password; do not commit .env.
FSP_POSTGRES_PASSWORD=replace-with-a-random-secret
FSP_PUBLIC_URL=http://localhost:8000
# FSP_DATABASE_URL=host=127.0.0.1 dbname=fsp user=fsp password=your-secret
# Optional neural provider. Without it, generator honestly reports validated_variants.
# FSP_OLLAMA_URL=http://127.0.0.1:11435
FSP_GENERATOR_MODEL=qwen2.5:0.5b
# Private CPU generator can use FSP_GENERATOR_PROTOCOL=llamacpp.
FSP_GENERATOR_PROTOCOL=ollama
FSP_GENERATOR_TIMEOUT=30
# FSP_GENERATOR_TOKEN=
# FSP_GENERATOR_REVISION=
# FSP_GENERATOR_QUANTIZATION=
# FSP_SMTP_HOST=smtp.example.org
FSP_SMTP_PORT=587
# Universal mail-service adapter, alternative to SMTP. Never commit real keys.
# FSP_DELIVERY_API_URL=https://your-provider.example/fsp-delivery/v1
# FSP_DELIVERY_API_KEY=<operator-generated-secret-at-least-32-characters>
# FSP_SMTP_FROM=career@example.org
# FSP_SMTP_USER=
# FSP_SMTP_PASSWORD=
# FSP_OIDC_ISSUER=https://id.example.org/realms/fsp
# FSP_OIDC_CLIENT_ID=fsp-career
# FSP_OIDC_CLIENT_SECRET=
FSP_OIDC_DEMO_ISSUER=0
# No Docker socket is mounted in the web container. Python code answers remain disabled.
FSP_CODE_SANDBOX=disabled

# Signed registry bridge restricted to this operator-selected issuer.
# FSP_REGISTRY_ISSUER=https://authorized-provider.example
# FSP_REGISTRY_API_KEY=<operator-generated-secret-at-least-32-characters>

# Reference test scripts only; never enable on the public service.
FSP_TEST_LOGIN=0
FSP_LEGACY_EMAIL_AUTH=0

# Local/API tests require a separate UTF-8 PostgreSQL database. Never production DSN.
# FSP_TEST_POSTGRES_DSN=host=127.0.0.1 dbname=fsp_test user=fsp_test password=your-test-secret
# External ATS runner checkpoint store, separate private operator database.
# FSP_ATS_STATE_DATABASE_URL=host=127.0.0.1 dbname=fsp_ats user=fsp_ats password=your-secret

# Registration follows TZ: email + one-time confirmation, existing usernames stay valid.
FSP_EMAIL_REQUIRED=1
FSP_SMTP_STARTTLS=1
# Implicit TLS, for example smtp.mail.ru:465. Keep STARTTLS=0 in this mode.
FSP_SMTP_SSL=0
# Local OIDC mock only; never put real account passwords in source control.
# FSP_MOCK_ACCOUNT_PASSWORD=
# FSP_OIDC_BACKCHANNEL_BASE=
